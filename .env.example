DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Africa/Douala

# Moteur de base de données : 'postgresql' (recommandé pour production/Postgres local) ou 'sqlite3'
DB_ENGINE=postgresql

# Paramètres de connexion PostgreSQL (si DB_ENGINE=postgresql)
POSTGRES_DB=poulailler
POSTGRES_USER=poulailler
POSTGRES_PASSWORD=poulailler_local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
